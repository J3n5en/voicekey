    # 纠错：纯数字拼写里一个键按成上下左右相邻的键（koyi → 可以），Q 标记保证只替换一处
    - fuzz/^(?=[2-9]{2})([2-9]*?)2([2-9]*)$/${1}3Q${2}/
    - fuzz/^(?=[2-9]{2})([2-9]*)2([2-9]*?)$/${1}3Q${2}/
    - fuzz/^(?=[2-9]{2})([2-9]*?)3([2-9]*)$/${1}2Q${2}/
    - fuzz/^(?=[2-9]{2})([2-9]*)3([2-9]*?)$/${1}2Q${2}/
    - fuzz/^(?=[2-9]{2})([2-9]*?)2([2-9]*)$/${1}5Q${2}/
    - fuzz/^(?=[2-9]{2})([2-9]*)2([2-9]*?)$/${1}5Q${2}/
    - fuzz/^(?=[2-9]{2})([2-9]*?)5([2-9]*)$/${1}2Q${2}/
    - fuzz/^(?=[2-9]{2})([2-9]*)5([2-9]*?)$/${1}2Q${2}/
    - fuzz/^(?=[2-9]{2})([2-9]*?)3([2-9]*)$/${1}6Q${2}/
    - fuzz/^(?=[2-9]{2})([2-9]*)3([2-9]*?)$/${1}6Q${2}/
    - fuzz/^(?=[2-9]{2})([2-9]*?)6([2-9]*)$/${1}3Q${2}/
    - fuzz/^(?=[2-9]{2})([2-9]*)6([2-9]*?)$/${1}3Q${2}/
    - fuzz/^(?=[2-9]{2})([2-9]*?)4([2-9]*)$/${1}5Q${2}/
    - fuzz/^(?=[2-9]{2})([2-9]*)4([2-9]*?)$/${1}5Q${2}/
    - fuzz/^(?=[2-9]{2})([2-9]*?)5([2-9]*)$/${1}4Q${2}/
    - fuzz/^(?=[2-9]{2})([2-9]*)5([2-9]*?)$/${1}4Q${2}/
    - fuzz/^(?=[2-9]{2})([2-9]*?)4([2-9]*)$/${1}7Q${2}/
    - fuzz/^(?=[2-9]{2})([2-9]*)4([2-9]*?)$/${1}7Q${2}/
    - fuzz/^(?=[2-9]{2})([2-9]*?)7([2-9]*)$/${1}4Q${2}/
    - fuzz/^(?=[2-9]{2})([2-9]*)7([2-9]*?)$/${1}4Q${2}/
    - fuzz/^(?=[2-9]{2})([2-9]*?)5([2-9]*)$/${1}6Q${2}/
    - fuzz/^(?=[2-9]{2})([2-9]*)5([2-9]*?)$/${1}6Q${2}/
    - fuzz/^(?=[2-9]{2})([2-9]*?)6([2-9]*)$/${1}5Q${2}/
    - fuzz/^(?=[2-9]{2})([2-9]*)6([2-9]*?)$/${1}5Q${2}/
    - fuzz/^(?=[2-9]{2})([2-9]*?)5([2-9]*)$/${1}8Q${2}/
    - fuzz/^(?=[2-9]{2})([2-9]*)5([2-9]*?)$/${1}8Q${2}/
    - fuzz/^(?=[2-9]{2})([2-9]*?)8([2-9]*)$/${1}5Q${2}/
    - fuzz/^(?=[2-9]{2})([2-9]*)8([2-9]*?)$/${1}5Q${2}/
    - fuzz/^(?=[2-9]{2})([2-9]*?)6([2-9]*)$/${1}9Q${2}/
    - fuzz/^(?=[2-9]{2})([2-9]*)6([2-9]*?)$/${1}9Q${2}/
    - fuzz/^(?=[2-9]{2})([2-9]*?)9([2-9]*)$/${1}6Q${2}/
    - fuzz/^(?=[2-9]{2})([2-9]*)9([2-9]*?)$/${1}6Q${2}/
    - fuzz/^(?=[2-9]{2})([2-9]*?)7([2-9]*)$/${1}8Q${2}/
    - fuzz/^(?=[2-9]{2})([2-9]*)7([2-9]*?)$/${1}8Q${2}/
    - fuzz/^(?=[2-9]{2})([2-9]*?)8([2-9]*)$/${1}7Q${2}/
    - fuzz/^(?=[2-9]{2})([2-9]*)8([2-9]*?)$/${1}7Q${2}/
    - fuzz/^(?=[2-9]{2})([2-9]*?)8([2-9]*)$/${1}9Q${2}/
    - fuzz/^(?=[2-9]{2})([2-9]*)8([2-9]*?)$/${1}9Q${2}/
    - fuzz/^(?=[2-9]{2})([2-9]*?)9([2-9]*)$/${1}8Q${2}/
    - fuzz/^(?=[2-9]{2})([2-9]*)9([2-9]*?)$/${1}8Q${2}/
    # 带 Q 的拼写（含残缺音节 ko）再经 4 次 fuzz，连同生成时那次共降权到 1/32：只有比拼对的候选常用得多才排到前面
    - fuzz/Q/R/
    - fuzz/R/S/
    - fuzz/S/T/
    - fuzz/T/U/
    - xform/U//
    - erase/^.*[Q-T].*$/
